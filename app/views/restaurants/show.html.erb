<h1><%= @restaurant.name %></h1>

<p>
  <div>Address: <%= @restaurant.address %></div>
  <div>Style: <%= @restaurant.category.capitalize %> style</div>
</p>

<p>
  <div>
    <%= link_to "Back to restaurants" , restaurants_path %>
  </div>
</p>

<p>
  <h4>What people think about us:</h4>
  <ul>
    <% @restaurant.reviews.each do |review| %>
      <li><%= review.content %>: ⭐ <%= review.rating %></li>
    <% end %>
  </ul>
  <div>
    <h4>Add a review:</h4>
    <%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.input :content %>
    <%= f.input :rating %>
    <%= f.submit "Submit Review" %>
    <% end %>
  </div>
</p>

<p>contact us: <%= @restaurant.phone_number %></p>
